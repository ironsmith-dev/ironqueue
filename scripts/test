#!/usr/bin/env bash

set -euo pipefail

# Source rather than run, to reuse its `DATABASE_URL` and its `cd` to the repository root.
source "${BASH_SOURCE[0]%/*}/migrate"

# Reset the query-count table, which fills with dead test databases and then evicts rows the tests measure against.
psql "$DATABASE_URL" -Atc "SELECT pg_stat_statements_reset()" >/dev/null 2>&1 || true

# Each SQLx test owns its database, but their workers intentionally use millisecond timers. Running hundreds of cases
# at once makes unrelated CPU and PostgreSQL contention look like missed leases and elapsed grace periods. The cases
# run serially; tests that exercise concurrency create it explicitly inside the case. Forward arguments so a run can
# still be narrowed, as in `scripts/test dedupe`. The `#[ignore]`d stress tier runs through `scripts/stress`.
cargo llvm-cov --locked --quiet --workspace --all-features --doctests --fail-under-lines 90 -- --test-threads=1 "$@"
