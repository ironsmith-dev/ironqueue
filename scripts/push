#!/usr/bin/env bash

set -euo pipefail

cd "${BASH_SOURCE[0]%/*}/.."

if [[ ${1:-} == "--check" ]]; then
    current_head="$(git rev-parse --verify HEAD)"
    if [[ ${IRONQUEUE_PREK_PUSH_HEAD:-} != "$current_head" ]]; then
        echo "push rejected: run scripts/push so prek validates HEAD before Git opens the remote connection" >&2
        exit 1
    fi

    if ! git diff --quiet || ! git diff --cached --quiet; then
        echo "push rejected: tracked files changed after prek validated HEAD" >&2
        exit 1
    fi

    exit 0
fi

# Git opens the remote transport before invoking its pre-push hook. Run the full suite first so a slow validation does
# not leave an SSH connection idle long enough for the server to close it. The fast pre-push hook checks this exact HEAD.
prek run --all-files
verified_head="$(git rev-parse --verify HEAD)"
IRONQUEUE_PREK_PUSH_HEAD="$verified_head" git push "$@"
