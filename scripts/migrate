#!/usr/bin/env bash

set -euo pipefail

cd "${BASH_SOURCE[0]%/*}/.."
export DATABASE_URL="${DATABASE_URL:-postgres://ironqueue:ironqueue@localhost:5439/ironqueue}"

docker compose up -d --wait postgres

# Call `sqlx` directly rather than `cargo sqlx` to skip cargo's startup.
sqlx migrate run --config ironqueue/sqlx.toml --source ironqueue/migrations
