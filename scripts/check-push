#!/usr/bin/env bash

set -euo pipefail

cd "${BASH_SOURCE[0]%/*}/.."

current_head="$(git rev-parse --verify HEAD)"
if [[ ${IRONQUEUE_PREK_PUSH_HEAD:-} != "$current_head" ]]; then
    echo "push rejected: run scripts/push so prek validates HEAD before Git opens the remote connection" >&2
    exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "push rejected: tracked files changed after prek validated HEAD" >&2
    exit 1
fi
